# target: 'any' | 'mug' | 'box' | 'can' | 'bottle' | 'cylindric' | 'ball' | 'other' | 'instance_<N>'
string target
int32 max_attempts
bool skip_place        # if true: grasp+lift+HOME only (debug); default false = full pick-and-place
---
bool success
int32 grasps_attempted
string message
---
string current_step    # e.g. 'inference', 'attempt', 'place', 'reset'
int32 attempt          # 1-based attempt counter within the current goal
int32 total_candidates # number of grasp candidates for the current object
