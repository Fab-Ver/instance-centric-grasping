# target: 'any' | 'mug' | 'box' | 'can' | 'bottle' | 'cylindric' | 'ball' | 'other' | 'instance_<N>'
string target
int32 max_attempts
bool skip_place        # if true: grasp+lift+HOME only (debug); default false = full pick-and-place
---
bool success
int32 grasps_attempted
string message
float32 planning_time     # ICGNet inference + grasp selection wall-time (s)
float32 execution_time    # arm/gripper motion time across attempts (s, sim clock)
bool collision_detected   # true if any Cartesian approach move failed (collision proxy)
bool target_not_found     # true if ICGNet returned no grasps for the target class
string failure_reason     # run-level outcome code: 'SUCCESS' | last failed attempt's code | 'PERCEPTION_NO_GRASP'
string[] attempt_reasons  # per-attempt outcome code (one entry per attempt; the successful one = 'SUCCESS')
string[] detected_classes # ICGNet class label per detected instance (pre class-filter), for class-confusion logging
