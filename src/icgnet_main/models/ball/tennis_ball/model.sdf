<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="tennis_ball">
    <link name="link">
      <inertial>
        <mass>0.058</mass>
        <!-- sphere: r=0.038m — I=2/5*m*r² -->
        <inertia>
          <ixx>0.0000335</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000335</iyy><iyz>0</iyz><izz>0.0000335</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.038</radius></sphere></geometry>
              <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
            <torsional>
              <coefficient>0.5</coefficient>
              <surface_radius>0.01</surface_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.038</radius></sphere></geometry>
        <material>
          <ambient>0.8 0.9 0.1 1</ambient><diffuse>0.8 0.9 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
