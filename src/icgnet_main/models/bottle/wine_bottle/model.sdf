<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="wine_bottle">
    <link name="link">
      <inertial>
        <mass>0.800</mass>
        <!-- cylinder: r=0.018m, h=0.300m -->
        <inertia>
          <ixx>0.006012</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.006012</iyy><iyz>0</iyz><izz>0.000130</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.018</radius><length>0.300</length></cylinder></geometry>
              <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
            <torsional>
              <coefficient>0.5</coefficient>
              <surface_radius>0.01</surface_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.018</radius><length>0.300</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.3 0.1 1</ambient><diffuse>0.1 0.3 0.1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
