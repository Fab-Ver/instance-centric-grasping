<sdf version="1.6">
  <model name="Weston_No_22_Cajun_Jerky_Tonic_12_fl_oz_nLj64ZnGwDh">
    <link name="link_0">
      <!-- 12 fl oz bottle ~0.40 kg; cylinder inertia (r=0.032 m, h=0.199 m). -->
      <inertial>
        <pose>0 0 0.0995 0 0 0</pose>
        <mass>0.40</mass>
        <inertia>
          <ixx>0.001422</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001422</iyy><iyz>0</iyz><izz>0.000205</izz>
        </inertia>
      </inertial>
      <collision name="collision_0">
        <geometry>
          <mesh>
            <uri>meshes/model.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.5</mu><mu2>0.5</mu2></ode>
            <torsional><coefficient>0.5</coefficient><surface_radius>0.01</surface_radius></torsional>
          </friction>
          <contact>
            <ode><kp>1e6</kp><kd>50</kd><min_depth>0.001</min_depth><max_vel>0.01</max_vel></ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/model.obj</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
