<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="water_bottle">
    <link name="link">
      <inertial>
        <mass>0.500</mass>
        <!-- cylinder: r=0.025m, h=0.220m -->
        <inertia>
          <ixx>0.002034</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.002034</iyy><iyz>0</iyz><izz>0.000156</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.025</radius><length>0.220</length></cylinder></geometry>
              <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
            </ode>
            <torsional>
              <coefficient>0.5</coefficient>
              <surface_radius>0.01</surface_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.1</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.025</radius><length>0.220</length></cylinder></geometry>
        <material>
          <ambient>0.7 0.9 1.0 0.8</ambient><diffuse>0.7 0.9 1.0 0.8</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
