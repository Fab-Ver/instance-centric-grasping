<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="cardboard_box">
    <link name="link">
      <inertial>
        <mass>0.200</mass>
        <!-- box: 0.065x0.060x0.090m — Ixx=m/12*(y²+z²) etc -->
        <inertia>
          <ixx>0.0001950</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0002054</iyy><iyz>0</iyz><izz>0.0001304</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.065 0.060 0.090</size></box></geometry>
              <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
            <torsional>
              <coefficient>0.5</coefficient>
              <surface_radius>0.01</surface_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.065 0.060 0.090</size></box></geometry>
        <material>
          <ambient>0.8 0.7 0.5 1</ambient><diffuse>0.8 0.7 0.5 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
