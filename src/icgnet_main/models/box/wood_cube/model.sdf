<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="wood_cube">
    <link name="link">
      <inertial>
        <mass>0.100</mass>
        <!-- box: 0.07x0.07x0.07m — Ixx=Iyy=Izz=m/12*(a²+a²) -->
        <inertia>
          <ixx>0.0000817</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000817</iyy><iyz>0</iyz><izz>0.0000817</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.070 0.070 0.070</size></box></geometry>
              <surface>
          <friction>
            <ode>
              <mu>0.5</mu>
              <mu2>0.5</mu2>
            </ode>
            <torsional>
              <coefficient>0.5</coefficient>
              <surface_radius>0.01</surface_radius>
            </torsional>
          </friction>
          <contact>
            <ode>
              <kp>1e6</kp>
              <kd>50</kd>
              <min_depth>0.001</min_depth>
              <max_vel>0.01</max_vel>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.070 0.070 0.070</size></box></geometry>
        <material>
          <ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
