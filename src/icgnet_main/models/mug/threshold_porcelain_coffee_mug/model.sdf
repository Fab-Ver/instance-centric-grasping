<sdf version="1.6">
    <model name="Threshold_Porcelain_Coffee_Mug_All_Over_Bead_White">
        <link name="link_0">
            <!-- Ceramic mug ~0.32 kg; inertia from bounding box (0.131 x 0.097 x 0.115 m). -->
            <inertial>
                <pose>0 0 0.0573 0 0 0</pose>
                <mass>0.32</mass>
                <inertia>
                    <ixx>0.000599</ixx><ixy>0</ixy><ixz>0</ixz>
                    <iyy>0.000806</iyy><iyz>0</iyz><izz>0.000704</izz>
                </inertia>
            </inertial>
            <collision name="collision_0">
                <geometry>
                    <mesh>
                        <uri>meshes/model.obj</uri>
                    </mesh>
                </geometry>
                <surface>
                    <friction>
                        <ode><mu>0.5</mu><mu2>0.5</mu2></ode>
                        <torsional><coefficient>0.5</coefficient><surface_radius>0.01</surface_radius></torsional>
                    </friction>
                    <contact>
                        <ode><kp>1e6</kp><kd>50</kd><min_depth>0.001</min_depth><max_vel>0.01</max_vel></ode>
                    </contact>
                </surface>
            </collision>
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>meshes/model.obj</uri>
                    </mesh>
                </geometry>
            </visual>
        </link>
    </model>
</sdf>
