<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="icgnet_world">

    <!-- Physics: DART solver (superior friction/contact vs ODE).
         Step 1ms at 1000 Hz = real-time physics. -->
    <plugin filename="libignition-gazebo6-physics-system.so"
            name="ignition::gazebo::systems::Physics">
      <engine>
        <filename>libignition-physics5-dartsim-plugin.so</filename>
      </engine>
    </plugin>

    <!-- Sensors system: render_engine=ogre for WSL2/OGRE1 compatibility.
         Provides RGB-D camera output. Must be ogre (not ogre2) on WSL2. -->
    <plugin filename="libignition-gazebo6-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <!-- Scene broadcaster: publishes scene state to GUI / ROS bridge. -->
    <plugin filename="libignition-gazebo6-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- User commands: enables /world/icgnet_world/create,
         /world/icgnet_world/remove, /world/icgnet_world/set_pose.
         Required for spawn_object and grasp_executor scene reset. -->
    <plugin filename="libignition-gazebo6-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>

    <!-- Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- RGB-D Camera — same pose as Classic world and as TF in world.launch.py.
         Pose: [x=0.97 y=0 z=0.616], RPY=[roll=0, pitch=1.0, yaw=π].
         Topic: /camera/rgbd_camera/{image, depth_image, points, camera_info}.
         IMPORTANT: this pose must always match the static_transform_publisher
         in world.launch.py (world → camera_link). -->
    <model name="camera_model">
      <static>true</static>
      <pose>0.97 0 0.616 0 1.0 3.14159</pose>
      <link name="camera_link">
        <visual name="visual">
          <geometry><box><size>0.05 0.1 0.05</size></box></geometry>
          <material><ambient>0 0 1 1</ambient></material>
        </visual>
        <sensor name="rgbd_camera" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.047198</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <!-- 5 Hz is sufficient: ICGNet inference is on-demand (uses last frame on /trigger).
               30 Hz in software rendering (WSL2) was killing RTF → arm moves appeared frozen. -->
          <update_rate>1</update_rate>
          <visualize>false</visualize>
          <!-- Topic base: publishes to /camera/rgbd_camera/{image,depth_image,points,camera_info} -->
          <topic>/camera/rgbd_camera</topic>
        </sensor>
      </link>
    </model>

    <!-- Drop bin: open-top box.
         Pose (0.45, -0.50): outside camera FOV (cam covers y ∈ [-0.35,0.35]) → no cloud pollution.
         Outer footprint 0.30×0.30m, walls h=0.10m, thickness=0.02m → inner opening ~0.26m. -->
    <model name="drop_bin">
      <static>true</static>
      <pose>0.45 -0.50 0 0 0 0</pose>

      <!-- Floor -->
      <link name="floor">
        <collision name="col"><geometry><box><size>0.30 0.30 0.005</size></box></geometry></collision>
        <visual name="vis">
          <pose>0 0 0.0025 0 0 0</pose>
          <geometry><box><size>0.30 0.30 0.005</size></box></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>0.9 0.5 0.0 1</diffuse></material>
        </visual>
      </link>

      <!-- Wall +X (half = 0.15) -->
      <link name="wall_px">
        <pose>0.14 0 0.05 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.02 0.30 0.10</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.02 0.30 0.10</size></box></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>0.9 0.5 0.0 1</diffuse></material>
        </visual>
      </link>

      <!-- Wall -X -->
      <link name="wall_nx">
        <pose>-0.14 0 0.05 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.02 0.30 0.10</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.02 0.30 0.10</size></box></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>0.9 0.5 0.0 1</diffuse></material>
        </visual>
      </link>

      <!-- Wall +Y -->
      <link name="wall_py">
        <pose>0 0.14 0.05 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.26 0.02 0.10</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.26 0.02 0.10</size></box></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>0.9 0.5 0.0 1</diffuse></material>
        </visual>
      </link>

      <!-- Wall -Y -->
      <link name="wall_ny">
        <pose>0 -0.14 0.05 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.26 0.02 0.10</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.26 0.02 0.10</size></box></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>0.9 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- TABLE DISABLED — uncomment to re-enable
    <model name="grasp_table">
      <static>true</static>
      <pose>0.65 0.0 0.025 0 0 0</pose>
      <link name="table_link">
        <collision name="collision">
          <geometry><box><size>0.8 0.8 0.05</size></box></geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.05</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient></material>
        </visual>
      </link>
    </model>
    -->

  </world>
</sdf>
